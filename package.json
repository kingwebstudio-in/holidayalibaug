{
  "name": "holidayalibag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server/dist",
    "lint": "tsc --noEmit && tsc -p server --noEmit",
    "dev:server": "tsx watch server/src/index.ts",
    "build:server": "tsc -p server",
    "build:all": "npm run build && npm run build:server",
    "start": "node server/dist/index.js",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:migrate:prod": "node server/dist/db/migrate.js",
    "db:seed-demo": "tsx server/src/cli/seedDemo.ts",
    "admin:create": "tsx server/src/cli/createAdmin.ts",
    "admin:create:prod": "node server/dist/cli/createAdmin.js",
    "test": "vitest run",
    "test:e2e:scroll": "node e2e/scroll.test.mjs",
    "test:e2e:flow": "node e2e/flow.test.mjs",
    "test:e2e:launch": "node e2e/launch.test.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev\"",
    "local:setup": "tsx server/src/cli/localSetup.ts",
    "local:reset": "tsx server/src/cli/localReset.ts",
    "doctor": "tsx server/src/cli/doctor.ts",
    "db:remove-demo": "tsx server/src/cli/removeDemo.ts",
    "privacy": "tsx server/src/cli/privacy.ts",
    "privacy:prod": "node server/dist/cli/privacy.js",
    "data:copy-to-postgres": "tsx server/src/cli/copyToPostgres.ts",
    "db:seed-demo:prod": "node server/dist/cli/seedDemo.js",
    "doctor:prod": "node server/dist/cli/doctor.js",
    "test:local": "TEST_DATA_MODE=local vitest run",
    "test:postgres": "TEST_DATA_MODE=postgres vitest run",
    "test:all": "npm run test:postgres && npm run test:local",
    "test:e2e:properties": "node e2e/properties.test.mjs",
    "test:e2e:whatsapp-media": "node e2e/whatsapp-media.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^27.0.2",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.4"
  }
}
